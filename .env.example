# ContextAI Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# DATABASE
# ===========================================
# SQLite database URL (local-first, no external DB required)
DATABASE_URL=sqlite:///./contextai.db

# ===========================================
# FASTAPI BACKEND
# ===========================================
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
FASTAPI_WORKERS=1
LOG_LEVEL=INFO

# ===========================================
# LLM PROVIDERS (Optional - for future phases)
# ===========================================
# Anthropic Claude
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Ollama (Local models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ===========================================
# FRONTEND (Vite/React)
# ===========================================
VITE_API_URL=http://127.0.0.1:8000
VITE_WS_URL=ws://127.0.0.1:8000

# ===========================================
# TAURI
# ===========================================
TAURI_DEBUG=true

# ===========================================
# ML / OCR
# ===========================================
# PaddleOCR settings
PADDLE_OCR_LANG=en
PADDLE_OCR_USE_GPU=false

# FAISS index path
FAISS_INDEX_PATH=./data/vectors/index.faiss

# ===========================================
# SECURITY / PERMISSIONS
# ===========================================
# Secret key for any token signing (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here-change-in-production

# Permission system defaults
DEFAULT_PERMISSION_LEVEL=YELLOW